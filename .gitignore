.env

# ruflo / claude-flow — generated state, memory store, daemon state.
# config.yaml is the deliberate quota-safe profile, so it stays tracked.
.claude-flow/*
!.claude-flow/config.yaml
.swarm/
ruvector.db

# ruflo writes these into the tracked .claude/ dir on its first CLI call
.claude/proven-config.json
.claude/.proven-config-version

# Claude Code — personal overrides (settings.json itself is shared, keep it tracked)
.claude/settings.local.json

# model weights - re-download from the URL in detect.py
*.pt

# datasets and training output - pulled with scripts/import_dataset.py, never committed
datasets/
runs/
*.onnx
*.engine

# Roboflow API key
.env
.env.*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# generated by scripts/train.py
data.yaml